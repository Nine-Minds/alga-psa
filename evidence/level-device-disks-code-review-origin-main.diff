diff --git a/ee/server/src/__tests__/integration/levelioEmulatorApiClient.integration.test.ts b/ee/server/src/__tests__/integration/levelioEmulatorApiClient.integration.test.ts
new file mode 100644
index 0000000000..6971b18d1f
--- /dev/null
+++ b/ee/server/src/__tests__/integration/levelioEmulatorApiClient.integration.test.ts
@@ -0,0 +1,208 @@
+/**
+ * Alga's real LevelIoApiClient against the algasim Level emulator, over HTTP.
+ *
+ * The emulator package knows nothing about the product: an import of ee/server
+ * from packages/emulators/levelio would make the Nx project graph circular
+ * (sebastian-ee already imports the emulator for the route test). So the
+ * consumer-side check lives here: cursor pagination, include_* detail
+ * sections, last_seen_at as incremental-sync input, alert/update filters and
+ * the client's 429/5xx handling. The vendor wire contract itself is covered by
+ * packages/emulators/levelio/tests/rest.test.ts.
+ */
+
+import { afterAll, beforeAll, beforeEach, describe, expect, it, vi } from 'vitest';
+import { EmulatorHost } from '@alga-psa/emulator-host';
+import levelio, { type LevelEmulatorCore } from '@alga-psa/emulator-levelio';
+import { LevelIoApiClient, LevelIoApiError } from '../../lib/integrations/levelio/levelApiClient';
+import { mapLevelIoDiskUsage } from '../../lib/integrations/levelio/mappers/deviceMapper';
+
+// createLevelIoClient imports the secrets provider at module load; the client
+// under test is constructed directly with the emulator's base URL.
+vi.mock('@alga-psa/core/secrets', () => ({
+  getSecretProviderInstance: async () => ({ getTenantSecret: async () => undefined }),
+}));
+
+const API_KEY = 'algasim-level-key';
+
+let host: EmulatorHost;
+let control: string;
+let vendor: string;
+let core: LevelEmulatorCore;
+
+async function callControl(kind: 'seed' | 'actions', name: string, params: unknown = {}) {
+  const response = await fetch(`${control}/control/levelio/${kind}/${name}`, {
+    method: 'POST',
+    headers: { 'content-type': 'application/json' },
+    body: JSON.stringify(params),
+  });
+  const json = (await response.json()) as { ok: boolean; result?: any; error?: string };
+  if (!json.ok) throw new Error(`${kind}/${name} failed: ${json.error}`);
+  return json.result;
+}
+
+const seed = (name: string, params?: unknown) => callControl('seed', name, params);
+const action = (name: string, params?: unknown) => callControl('actions', name, params);
+
+async function arm(name: string, params: unknown = {}) {
+  const response = await fetch(`${control}/control/levelio/faults/${name}/arm`, {
+    method: 'POST',
+    headers: { 'content-type': 'application/json' },
+    body: JSON.stringify(params),
+  });
+  if (response.status !== 200) throw new Error(`arm ${name} failed: ${await response.text()}`);
+}
+
+function client(apiKey = API_KEY) {
+  return new LevelIoApiClient({ apiKey, baseUrl: vendor, maxRetries: 2 });
+}
+
+beforeAll(async () => {
+  host = new EmulatorHost({ emulators: [levelio], controlPort: 0, ports: { levelio: 0 } });
+  const { controlPort, ports } = await host.start();
+  control = `http://127.0.0.1:${controlPort}`;
+  vendor = `http://127.0.0.1:${ports.levelio}`;
+  core = host.instance('levelio').core as LevelEmulatorCore;
+});
+
+afterAll(async () => {
+  await host.stop();
+});
+
+beforeEach(async () => {
+  await fetch(`${control}/control/levelio/reset`, { method: 'POST' });
+});
+
+describe('LevelIoApiClient against the Level emulator', () => {
+  it('testConnection succeeds with the key and surfaces 401 as LevelIoApiError otherwise', async () => {
+    await expect(client().testConnection()).resolves.toBeUndefined();
+    await expect(client('wrong-key').testConnection()).rejects.toMatchObject({ status: 401 });
+
+    await action('revoke-api-key', { key: API_KEY });
+    await expect(client().testConnection()).rejects.toBeInstanceOf(LevelIoApiError);
+  });
+
+  it('listGroups walks the hierarchy across pages with limit=100 + starting_after', async () => {
+    const root = (await seed('group', { name: 'Acme Corp' })).group;
+    for (let i = 0; i < 104; i += 1) {
+      await seed('group', { name: `Site ${i}`, parentId: root.id });
+    }
+    await seed('device', { hostname: 'WS-01', groupId: root.id });
+
+    const groups = await client().listGroups();
+    expect(groups).toHaveLength(105);
+    expect(new Set(groups.map((g) => g.id)).size).toBe(105);
+    const acme = groups.find((g) => g.id === root.id)!;
+    expect(acme).toMatchObject({ parent_id: null, name: 'Acme Corp', device_count: 1, descendent_device_count: 1 });
+    expect(acme.child_ids).toHaveLength(104);
+    expect(root.id).toBe('Z2lkOi8vbGV2ZWwvRGV2aWNlR3JvdXAvMQ'); // gid://level/DeviceGroup/1, Level's id form
+  });
+
+  it('listDevices asks for the detail sections and filters by ancestor group; getDevice carries security', async () => {
+    const acme = (await seed('group', { name: 'Acme' })).group;
+    const branch = (await seed('group', { name: 'Branch', parentId: acme.id })).group;
+    const other = (await seed('group', { name: 'Other' })).group;
+    const ws = (
+      await seed('device', {
+        hostname: 'WS-01',
+        groupId: branch.id,
+        serial_number: 'SN-1',
+        operating_system: { full_operating_system: 'Windows 11 Pro', major_version: '10.0' },
+        network_interfaces: [{ interface: 'eth0', ip_addresses: ['10.0.0.5'] }],
+        disks: [{ disk_type: 'NVMe', model: 'Samsung', size: 512_000_000_000 }],
+        security: { score: 80 },
+      })
+    ).device;
+    await seed('device', { hostname: 'OTHER-01', groupId: other.id });
+
+    const devices = await client().listDevices({ ancestorGroupId: acme.id });
+    expect(devices.map((d) => d.hostname)).toEqual(['WS-01']);
+    expect(devices[0].operating_system).toEqual({ full_operating_system: 'Windows 11 Pro', major_version: '10.0' });
+    expect(devices[0].network_interfaces).toHaveLength(1);
+    // Level's documented device carries `disks`, which Alga's type and mapper read.
+    expect(devices[0].disks).toHaveLength(1);
+    expect((devices[0] as unknown as Record<string, unknown>).disk_partitions).toBeUndefined();
+    expect(mapLevelIoDiskUsage(devices[0])).toEqual([{ name: 'NVMe Samsung', total_gb: 476.84 }]);
+
+    expect((await client().getDevice(ws.id)).security).toEqual({ score: 80 });
+    expect(await client().listDevices({ groupId: acme.id })).toEqual([]);
+    await expect(client().getDevice('nope')).rejects.toMatchObject({ status: 404 });
+  });
+
+  it('reports last_seen_at as now for online devices and frozen for offline ones (incremental sync input)', async () => {
+    const online = (await seed('device', { hostname: 'ONLINE' })).device;
+    const offline = (await seed('device', { hostname: 'OFFLINE' })).device;
+    await action('device-offline', { deviceId: offline.id });
+    const frozenAt = core.getDevice(offline.id).last_seen_at!;
+
+    host.clock.advance('2h');
+    const since = new Date(host.clock.now().getTime() - 60_000);
+    const devices = await client().listDevices();
+    const byHost = Object.fromEntries(devices.map((d) => [d.hostname, d]));
+    expect(byHost.OFFLINE.last_seen_at).toBe(frozenAt);
+    expect(new Date(byHost.ONLINE.last_seen_at!).getTime()).toBeGreaterThanOrEqual(since.getTime());
+    // The sync engine's incremental filter keeps devices seen at/after `since`.
+    const changed = devices.filter((d) => !d.last_seen_at || new Date(d.last_seen_at) >= since);
+    expect(changed.map((d) => d.id)).toEqual([online.id]);
+
+    await action('device-checkin', { deviceId: offline.id });
+    expect((await client().getDevice(offline.id)).online).toBe(true);
+  });
+
+  it('lists alerts by device and status, and resolves through POST /resolve', async () => {
+    const ws = (await seed('device', { hostname: 'WS-01' })).device;
+    const srv = (await seed('device', { hostname: 'SRV-01', role: 'server' })).device;
+    const disk = (
+      await action('fire-alert', {
+        deviceId: ws.id,
+        name: 'Low disk space',
+        description: 'Disk free < 5.0%',
+        severity: 'critical',
+        payload: '4.37% (10.39 GB) remaining',
+      })
+    ).alert;
+    await action('fire-alert', { deviceId: srv.id, name: 'CPU', severity: 'warning' });
+
+    const active = await client().listAlerts({ status: 'active' });
+    expect(active).toHaveLength(2);
+    expect(active[0]).toEqual({
+      id: disk.id,
+      device_id: ws.id,
+      device_hostname: 'WS-01',
+      name: 'Low disk space',
+      description: 'Disk free < 5.0%',
+      payload: '4.37% (10.39 GB) remaining',
+      severity: 'critical',
+      is_resolved: false,
+      started_at: expect.any(String),
+      resolved_at: null,
+    });
+
+    await client().resolveAlert(disk.id);
+    expect((await client().listAlerts({ status: 'resolved' })).map((a) => a.id)).toEqual([disk.id]);
+    expect(await client().listAlerts({ deviceId: srv.id })).toHaveLength(1);
+  });
+
+  it('lists updates filtered by device and status', async () => {
+    const ws = (await seed('device', { hostname: 'WS-01' })).device;
+    await seed('update', { deviceId: ws.id, name: 'KB5034441', category: 'Security Updates' });
+    await seed('update', { deviceId: ws.id, name: 'KB0000001', is_available: false, installed_on: '2026-10-01T00:00:00.000Z' });
+    expect((await client().listUpdates({ deviceId: ws.id, status: 'available' })).map((u) => u.name)).toEqual(['KB5034441']);
+    expect((await client().listUpdates({ status: 'installed' })).map((u) => u.name)).toEqual(['KB0000001']);
+  });
+
+  it('retries a 429 after Retry-After, then surfaces persistent 429 and 5xx as errors', async () => {
+    await seed('group', { name: 'Acme' });
+
+    await arm('rate-limit', { remaining: 2, retryAfterSeconds: 0 });
+    await expect(client().listGroups()).resolves.toHaveLength(1);
+    const journal = (await (await fetch(`${control}/control/levelio/requests`)).json()).result;
+    expect(journal.requests.filter((r: { status: number }) => r.status === 429)).toHaveLength(2);
+
+    await arm('rate-limit', { remaining: 3, retryAfterSeconds: 0 });
+    await expect(client().listGroups()).rejects.toMatchObject({ status: 429 }); // maxRetries: 2
+
+    await arm('operation-fault', { operation: 'GET /v2/devices', status: 503, message: 'Service unavailable' });
+    await expect(client().listDevices()).rejects.toMatchObject({ status: 503 });
+    await expect(client().listDevices()).resolves.toEqual([]);
+  });
+});
diff --git a/ee/server/src/__tests__/integration/levelioEmulatorRoute.integration.test.ts b/ee/server/src/__tests__/integration/levelioEmulatorRoute.integration.test.ts
new file mode 100644
index 0000000000..e4d4ee905a
--- /dev/null
+++ b/ee/server/src/__tests__/integration/levelioEmulatorRoute.integration.test.ts
@@ -0,0 +1,364 @@
+/**
+ * Level.io alert ingestion, end to end through the algasim Level emulator.
+ *
+ * The real EE webhook route runs behind a local HTTP listener against a real
+ * database. The emulator plays Level: it sends native webhooks and monitor
+ * automation HTTP requests exactly as Level does, and serves the v2 REST API
+ * the route calls back into (LEVELIO_API_BASE_URL). The two prod-failure
+ * scenarios are the bundled suite files
+ * (packages/emulators/suite/scenarios/levelio-*.yaml), retargeted at the route.
+ *
+ * KNOWN PROD FAILURES (2026-10-15). The first two tests assert the broken
+ * behavior the route had when they were written:
+ *   (a) native webhook with a secret → 401 on every attempt, nothing recorded;
+ *   (b) Alga's pasted payload template via an automation → 200, but the
+ *       literal {{alert_id}} collapses every alert into one rmm_alerts row and
+ *       no ticket is created.
+ * When the route fix lands they fail by design. Flip them to assert that the
+ * signed envelopes are accepted and that the CPU alert on SRV-01 creates a
+ * ticket for Acme Corp (the third test shows the fixture can do that).
+ */
+
+import { readFileSync } from 'node:fs';
+import http from 'node:http';
+import { afterAll, beforeAll, describe, expect, it, vi } from 'vitest';
+import type { Knex } from 'knex';
+import { v4 as uuidv4 } from 'uuid';
+import { tenantDb } from '@alga-psa/db';
+import { EmulatorHost, loadScenarioFile, runScenario } from '@alga-psa/emulator-host';
+import levelio, { retargetScenario, type LevelEmulatorCore } from '@alga-psa/emulator-levelio';
+import { createTestDbConnection } from '@main-test-utils/dbConfig';
+
+const HOOK_TIMEOUT = 180_000;
+
+const ALGA_WEBHOOK_SECRET = 'algasim-alga-webhook-secret';
+const LEVEL_API_KEY = 'algasim-level-key';
+
+const h = vi.hoisted(() => ({ db: null as unknown as Knex }));
+
+vi.mock('@alga-psa/core/secrets', () => ({
+  getSecretProviderInstance: async () => ({
+    getAppSecret: async () => undefined,
+    getTenantSecret: async (_tenant: string, name: string) =>
+      ({ levelio_webhook_secret: ALGA_WEBHOOK_SECRET, levelio_api_key: LEVEL_API_KEY })[name],
+    setTenantSecret: async () => undefined,
+  }),
+}));
+
+vi.mock('@alga-psa/db', async () => {
+  const actual = await vi.importActual<typeof import('@alga-psa/db')>('@alga-psa/db');
+  return { ...actual, createTenantKnex: async (tenant?: string) => ({ knex: h.db, tenant: tenant ?? null }) };
+});
+
+vi.mock('@alga-psa/event-bus/publishers', () => ({
+  publishEvent: vi.fn(async () => undefined),
+  publishWorkflowEvent: vi.fn(async () => undefined),
+  publishNonCatalogWorkflowEvent: vi.fn(async () => undefined),
+  publishStoredWorkflowEvent: vi.fn(async () => undefined),
+  publishBuiltWorkflowPayload: vi.fn(async () => undefined),
+}));
+
+const { POST } = await import('../../app/api/webhooks/levelio/route');
+
+/**
+ * The payload template and header name getLevelIoWebhookInfo hands out, read
+ * from source (the server action itself needs a session and tier gate).
+ */
+function algaSettingsTemplate(): { headerName: string; payloadTemplate: string } {
+  const source = readFileSync(new URL('../../lib/actions/integrations/levelIoActions.ts', import.meta.url), 'utf8');
+  const literal = /const payloadTemplate = JSON\.stringify\(\s*(\{[\s\S]*?\})\s*,\s*null\s*,\s*2\s*\)/.exec(source)?.[1];
+  const headerName = /headerName: '([^']+)'/.exec(source)?.[1];
+  if (!literal || !headerName) throw new Error('getLevelIoWebhookInfo no longer builds a payload template; update this test');
+  return { headerName, payloadTemplate: JSON.stringify(new Function(`return (${literal});`)(), null, 2) };
+}
+
+const tenantId = uuidv4();
+const userId = uuidv4();
+const clientId = uuidv4();
+const boardId = uuidv4();
+const integrationId = uuidv4();
+
+// Fixed ids from the scenario files.
+const ACME = 'Z2lkOi8vbGV2ZWwvRGV2aWNlR3JvdXAvMQ';
+const BRANCH = 'Z2lkOi8vbGV2ZWwvRGV2aWNlR3JvdXAvMg';
+const WS_01 = 'Z2lkOi8vbGV2ZWwvRGV2aWNlLzE';
+const SRV_01 = 'Z2lkOi8vbGV2ZWwvRGV2aWNlLzI';
+
+const SCENARIOS = new URL('../../../../../packages/emulators/suite/scenarios/', import.meta.url);
+
+let routeServer: http.Server;
+let routeOrigin: string;
+let host: EmulatorHost;
+let control: string;
+
+function table(name: string) {
+  return tenantDb(h.db, tenantId).table(name);
+}
+
+async function hasColumn(name: string, column: string) {
+  return h.db.schema.hasColumn(name, column);
+}
+
+/** The Next route handler behind a real socket, so the emulator talks HTTP to it. */
+async function startRouteServer() {
+  const server = http.createServer(async (req, res) => {
+    const chunks: Buffer[] = [];
+    for await (const chunk of req) chunks.push(chunk as Buffer);
+    const headers = new Headers();
+    for (const [name, value] of Object.entries(req.headers)) {
+      if (typeof value === 'string') headers.set(name, value);
+    }
+    const response = await POST(
+      new Request(`${routeOrigin}${req.url}`, { method: req.method, headers, body: Buffer.concat(chunks) }),
+    );
+    res.writeHead(response.status, { 'content-type': 'application/json' });
+    res.end(await response.text());
+  });
+  await new Promise<void>((resolve) => server.listen(0, '127.0.0.1', resolve));
+  routeOrigin = `http://127.0.0.1:${(server.address() as { port: number }).port}`;
+  return server;
+}
+
+async function runLevelScenario(name: string) {
+  const scenario = retargetScenario(loadScenarioFile(new URL(`${name}.yaml`, SCENARIOS).pathname), {
+    'http://localhost:4030': routeOrigin,
+    'tenant=algasim-tenant': `tenant=${tenantId}`,
+  });
+  await runScenario(host, scenario);
+}
+
+async function levelState(view: string) {
+  return ((await (await fetch(`${control}/control/levelio/state/${view}`)).json()) as { result: any }).result;
+}
+
+async function rmmAlerts() {
+  return table('rmm_alerts').where({ tenant: tenantId }).select('external_alert_id', 'external_device_id', 'ticket_id', 'status');
+}
+
+async function ticketCount() {
+  const row = await table('tickets').where({ tenant: tenantId }).count('ticket_id as n').first();
+  return Number(row?.n ?? 0);
+}
+
+async function clearAlertsAndTickets() {
+  for (const name of ['comments', 'comment_threads', 'asset_associations', 'rmm_alerts', 'tickets']) {
+    await table(name).where({ tenant: tenantId }).del().catch(() => undefined);
+  }
+}
+
+beforeAll(async () => {
+  process.env.DB_PORT = process.env.DB_PORT || '5432';
+  process.env.APP_ENV = process.env.APP_ENV || 'test';
+  h.db = await createTestDbConnection();
+
+  await table('tenants').insert({
+    tenant: tenantId,
+    ...((await hasColumn('tenants', 'company_name')) ? { company_name: 'Level Emulator Tenant' } : { client_name: 'Level Emulator Tenant' }),
+    email: `level-emu-${tenantId.slice(0, 8)}@example.com`,
+    created_at: h.db.fn.now(),
+    updated_at: h.db.fn.now(),
+  });
+  await table('users').insert({
+    tenant: tenantId,
+    user_id: userId,
+    username: `level-emu-${tenantId.slice(0, 8)}`,
+    hashed_password: 'not-used',
+    email: `level-emu-user-${tenantId.slice(0, 8)}@example.com`,
+    created_at: h.db.fn.now(),
+    updated_at: h.db.fn.now(),
+  });
+  await table('clients').insert({
+    tenant: tenantId,
+    client_id: clientId,
+    client_name: 'Acme Corp',
+    properties: JSON.stringify({}),
+    is_inactive: false,
+    created_at: h.db.fn.now(),
+    updated_at: h.db.fn.now(),
+  });
+  await table('boards').insert({ tenant: tenantId, board_id: boardId, board_name: 'Alerts', is_default: true });
+  const statusItemType = {
+    ...((await hasColumn('statuses', 'item_type')) ? { item_type: 'ticket' } : {}),
+    ...((await hasColumn('statuses', 'status_type')) ? { status_type: 'ticket' } : {}),
+  };
+  await table('statuses').insert([
+    { tenant: tenantId, status_id: uuidv4(), name: 'Open', ...statusItemType, board_id: boardId, is_closed: false, is_default: true, order_number: 10, created_by: userId },
+    { tenant: tenantId, status_id: uuidv4(), name: 'Closed', ...statusItemType, board_id: boardId, is_closed: true, is_default: false, order_number: 20, created_by: userId },
+  ]);
+  await table('rmm_integrations').insert({
+    tenant: tenantId,
+    integration_id: integrationId,
+    provider: 'levelio',
+    instance_url: 'https://api.level.io',
+    is_active: true,
+    connected_at: h.db.fn.now(),
+    settings: JSON.stringify({}),
+  });
+  await table('rmm_organization_mappings').insert({
+    tenant: tenantId,
+    mapping_id: uuidv4(),
+    integration_id: integrationId,
+    external_organization_id: ACME,
+    external_organization_name: 'Acme Corp',
+    client_id: clientId,
+    default_contact_id: null,
+    auto_sync_assets: true,
+    auto_create_tickets: false,
+  });
+  // Both scenario devices, synced: the realm is the deepest mapped group (Acme).
+  for (const [deviceId, name] of [[WS_01, 'WS-01'], [SRV_01, 'SRV-01']] as const) {
+    const assetId = uuidv4();
+    await table('assets').insert({
+      tenant: tenantId,
+      asset_id: assetId,
+      asset_type: deviceId === SRV_01 ? 'server' : 'workstation',
+      name,
+      asset_tag: `levelio:${deviceId}`,
+      serial_number: `SN-${name}`,
+      status: 'active',
+      client_id: clientId,
+      rmm_provider: 'levelio',
+      rmm_device_id: deviceId,
+      created_at: h.db.fn.now(),
+      updated_at: h.db.fn.now(),
+    });
+    await table('tenant_external_entity_mappings').insert({
+      tenant: tenantId,
+      id: uuidv4(),
+      integration_type: 'levelio',
+      alga_entity_type: 'asset',
+      alga_entity_id: assetId,
+      external_entity_id: deviceId,
+      external_realm_id: ACME,
+      sync_status: 'synced',
+      created_at: h.db.fn.now(),
+      updated_at: h.db.fn.now(),
+    });
+  }
+  // The prod shape: a group-scoped rule that tickets every Acme alert.
+  await table('rmm_alert_rules').insert({
+    tenant: tenantId,
+    rule_id: uuidv4(),
+    integration_id: integrationId,
+    name: 'Acme alerts',
+    is_active: true,
+    priority_order: 0,
+    conditions: JSON.stringify({ organizationIds: [ACME] }),
+    actions: JSON.stringify({ createTicket: true, boardId }),
+  });
+
+  routeServer = await startRouteServer();
