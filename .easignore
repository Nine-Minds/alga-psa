# EAS archives the whole git repo for ee/mobile builds and reads .easignore
# only from the repo root. Upload just the mobile app and the shared sources
# it imports by relative path (packages/validation, packages/tickets/src/lib).
/*
!/.npmrc
!/package.json
!/package-lock.json

!/ee/
/ee/*
!/ee/mobile/
/ee/mobile/.expo/
/ee/mobile/ios/
/ee/mobile/android/
/ee/mobile/dist/
/ee/mobile/web-build/

!/packages/
/packages/*
!/packages/validation/
/packages/validation/*
!/packages/validation/src/
!/packages/tickets/
/packages/tickets/*
!/packages/tickets/src/
/packages/tickets/src/*
!/packages/tickets/src/lib/
