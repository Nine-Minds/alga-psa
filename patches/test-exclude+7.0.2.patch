+// minimatch(path, pattern) compiles the pattern on every call, and
+// shouldInstrument runs once per file per pattern. Vitest appends every test
+// include to coverage.exclude, so a server-unit shard (an explicit list of ~965
+// files) recompiled ~2000 patterns per covered file: coverage generation took
+// 11-22 minutes and pushed shards past their job timeout. Compile each pattern
+// once; `new Minimatch(p, opts).match(f)` is exactly what minimatch() does.
+const compiledPatterns = new Map();
+function compiledPattern(pattern) {
+    let compiled = compiledPatterns.get(pattern);
+    if (!compiled) {
+        compiled = new Minimatch(pattern, { dot: true });
+        compiledPatterns.set(pattern, compiled);
+    }
+    return compiled;
+}
