   # Template definitions
+  # Consumer-owned verifier is pinned independently of the candidate source.
+  - name: verify-source-readiness
+    inputs:
+      parameters:
+      - name: source-ref
+      - name: repo-url
+    outputs:
+      parameters:
+      - name: commit-sha
+        valueFrom:
+          path: /tmp/verified-commit-sha
+      artifacts:
+      - name: source-readiness
+        path: /tmp/source-readiness.json
+    script:
+      image: node:22-alpine
+      command: [node, --input-type=module]
+      env:
+      - name: SOURCE_REF
+        value: "{{inputs.parameters.source-ref}}"
+      - name: SOURCE_REPO_URL
+        value: "{{inputs.parameters.repo-url}}"
+      - name: GITHUB_TOKEN
+        valueFrom:
+          secretKeyRef:
+            name: github-token
+            key: token
+      source: |
+        import { writeFileSync } from 'node:fs';
+        const repository = 'Nine-Minds/alga-psa';
+        const verifierRevision = '885f4e78824e36b1b0447ff9df987305f46d1abc';
+        if (process.env.SOURCE_REPO_URL !== `https://github.com/${repository}.git`) {
+          throw new Error('Source repository must match the readiness repository');
+        }
+        const get = async (route, accept = 'application/vnd.github+json') => {
+          const response = await fetch(`https://api.github.com/repos/${repository}/${route}`, {
+            headers: { Accept: accept, Authorization: `Bearer ${process.env.GITHUB_TOKEN}`,
+              'X-GitHub-Api-Version': '2022-11-28' },
+            redirect: 'error', signal: AbortSignal.timeout(30000),
+          });
+          if (!response.ok) throw new Error(`GitHub source lookup failed: HTTP ${response.status}`);
+          return response;
+        };
+        if (!process.env.SOURCE_REF?.trim()) throw new Error('Source ref is required');
+        const commit = await (await get(`commits/${encodeURIComponent(process.env.SOURCE_REF)}`)).json();
+        if (!/^[a-f0-9]{40}$/.test(commit.sha ?? '')) throw new Error('Full source SHA was not resolved');
+        const verifier = await (await get(
+          `contents/scripts/lib/published-readiness.mjs?ref=${verifierRevision}`,
+          'application/vnd.github.raw+json',
+        )).text();
+        writeFileSync('/tmp/published-readiness.mjs', verifier);
+        const { verifyPublishedReadiness } = await import('file:///tmp/published-readiness.mjs');
+        const result = await verifyPublishedReadiness({ revision: commit.sha, token: process.env.GITHUB_TOKEN });
+        writeFileSync('/tmp/source-readiness.json', JSON.stringify(result, null, 2) + '\n');
+        if (result.status !== 'passed') throw new Error(result.failures.join('; '));
+        writeFileSync('/tmp/verified-commit-sha', commit.sha + '\n');
+
