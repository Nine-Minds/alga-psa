{
  "version": 1,
  "cases": [
    {
      "id": "scalar-equals",
      "description": "equals matches the same value; a missing value never matches",
      "covers": {
        "operators": [
          "equals"
        ],
        "pathKind": "scalar"
      },
      "predicate": {
        "path": "s",
        "operator": "equals",
        "value": "x"
      },
      "rows": [
        {
          "id": "match",
          "record": {
            "s": "x"
          },
          "expected": true
        },
        {
          "id": "other",
          "record": {
            "s": "y"
          },
          "expected": false
        },
        {
          "id": "missing",
          "record": {},
          "expected": false
        },
        {
          "id": "case-differs",
          "record": {
            "s": "X"
          },
          "expected": false
        }
      ]
    },
