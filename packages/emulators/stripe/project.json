{
  "name": "@alga-psa/emulator-stripe",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/emulators/stripe/src",
  "projectType": "library",
  "tags": [
    "scope:emulator-stripe",
    "type:test-infra"
  ],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": [
        "{projectRoot}/dist"
      ],
      "options": {
        "command": "tsup",
        "cwd": "{projectRoot}"
      },
      "inputs": [
        "production",
        "^production"
      ]
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --noEmit",
        "cwd": "{projectRoot}"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest run",
        "cwd": "{projectRoot}"
      },
      "dependsOn": [
        "^build"
      ]
    }
  }
}
