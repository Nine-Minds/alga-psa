{
  "name": "@alga-psa/storage",
  "version": "0.1.0",
  "private": true,
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "types": "./src/index.ts"
    },
    "./fileUploadTransaction": {
      "import": "./dist/fileUploadTransaction.mjs",
      "types": "./src/fileUploadTransaction.ts"
    },
    "./StorageService": {
      "import": "./dist/StorageService.mjs",
      "types": "./src/StorageService.ts"
    },
    "./StorageProviderFactory": {
      "import": "./dist/StorageProviderFactory.mjs",
      "types": "./src/StorageProviderFactory.ts"
    },
    "./models/storage": {
      "import": "./dist/models/storage.mjs",
      "types": "./src/models/storage.ts"
    },
    "./types/storage": {
      "import": "./dist/types/storage.mjs",
      "types": "./src/types/storage.ts"
    },
    "./providers/StorageProvider": {
      "import": "./dist/providers/StorageProvider.mjs",
      "types": "./src/providers/StorageProvider.ts"
    },
    "./providers/S3StorageProvider": {
      "import": "./dist/providers/S3StorageProvider.mjs",
      "types": "./src/providers/S3StorageProvider.ts"
    },
    "./config/storage": {
      "import": "./dist/config/storage.mjs",
      "types": "./src/config/storage.ts"
    },
    "./ingest/pipeline": {
      "import": "./dist/ingest/pipeline.mjs",
      "types": "./src/ingest/pipeline.ts"
    },
    "./ingest/mime": {
      "import": "./dist/ingest/mime.mjs",
      "types": "./src/ingest/mime.ts"
    },
    "./ingest/bufferedCap": {
      "import": "./dist/ingest/bufferedCap.mjs",
      "types": "./src/ingest/bufferedCap.ts"
    },
    "./ingest/errors": {
      "import": "./dist/ingest/errors.mjs",
      "types": "./src/ingest/errors.ts"
    }
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.985.0",
    "@aws-sdk/s3-request-presigner": "^3.985.0",
    "@alga-psa/core": "*",
    "@alga-psa/db": "*",
    "@alga-psa/event-bus": "*",
    "@alga-psa/event-schemas": "*",
    "@alga-psa/formatting": "*",
    "@alga-psa/types": "*",
    "@alga-psa/validation": "*",
    "file-type": "^21.3.2"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "vitest": "^4.1.11"
  }
}
