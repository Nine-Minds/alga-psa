{
  "name": "@alga-psa/authorization",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./src/index.ts"
    },
    "./kernel": {
      "import": "./dist/kernel/index.js",
      "types": "./src/kernel/index.ts"
    },
    "./kernel/*": {
      "types": "./src/kernel/*.ts",
      "import": "./dist/kernel/*.js"
    },
    "./quoteSelfApproval": {
      "import": "./dist/quoteSelfApproval.js",
      "types": "./src/quoteSelfApproval.ts"
    },
    "./portal": {
      "import": "./dist/portal/visibility.js",
      "types": "./src/portal/visibility.ts"
    },
    "./portal/*": {
      "import": "./dist/portal/*.js",
      "types": "./src/portal/*.ts"
    },
    "./bundles/catalog": {
      "import": "./dist/bundles/catalog.js",
      "types": "./src/bundles/catalog.ts"
    },
    "./bundles/service": {
      "import": "./dist/bundles/service.js",
      "types": "./src/bundles/service.ts"
    },
    "./bundles/narrowingProvider": {
      "import": "./dist/bundles/narrowingProvider.js",
      "types": "./src/bundles/narrowingProvider.ts"
    },
    "./bundles/starterBundles": {
      "import": "./dist/bundles/starterBundles.js",
      "types": "./src/bundles/starterBundles.ts"
    },
    "./bundles/closedBundlePreview": {
      "import": "./dist/bundles/closedBundlePreview.js",
      "types": "./src/bundles/closedBundlePreview.ts"
    },
    "./bundles/denialExplanations": {
      "import": "./dist/bundles/denialExplanations.js",
      "types": "./src/bundles/denialExplanations.ts"
    },
    "./portfolios/service": {
      "import": "./dist/portfolios/service.js",
      "types": "./src/portfolios/service.ts"
    },
    "./subject": {
      "import": "./dist/subject/index.js",
      "types": "./src/subject/index.ts"
    },
    "./subject/*": {
      "import": "./dist/subject/*.js",
      "types": "./src/subject/*.ts"
    },
    "./adapters/rbac": {
      "import": "./dist/adapters/rbac.js",
      "types": "./src/adapters/rbac.ts"
    },
    "./pagination": {
      "import": "./dist/pagination/index.js",
      "types": "./src/pagination/index.ts"
    },
    "./pagination/authorizationAwarePagination": {
      "import": "./dist/pagination/authorizationAwarePagination.js",
      "types": "./src/pagination/authorizationAwarePagination.ts"
    },
    "./assetReadAuthorization": {
      "import": "./dist/assetReadAuthorization.js",
      "types": "./src/assetReadAuthorization.ts"
    },
    "./clientReadScope": {
      "import": "./dist/clientReadScope.js",
      "types": "./src/clientReadScope.ts"
    },
    "./knowledgeBaseReadAuthorization": {
      "import": "./dist/knowledgeBaseReadAuthorization.js",
      "types": "./src/knowledgeBaseReadAuthorization.ts"
    },
    "./readScope": {
      "import": "./dist/readScope.js",
      "types": "./src/readScope.ts"
    },
    "./scheduleEntryReadAuthorization": {
      "import": "./dist/scheduleEntryReadAuthorization.js",
      "types": "./src/scheduleEntryReadAuthorization.ts"
    },
    "./ticketReadAuthorization": {
      "import": "./dist/ticketReadAuthorization.js",
      "types": "./src/ticketReadAuthorization.ts"
    },
    "./ticketRecordAuthorization": {
      "import": "./dist/ticketRecordAuthorization.js",
      "types": "./src/ticketRecordAuthorization.ts"
    },
    "./clientScopeAuthorization": {
      "import": "./dist/clientScopeAuthorization.js",
      "types": "./src/clientScopeAuthorization.ts"
    },
    "./ticketScopeAuthorization": {
      "import": "./dist/ticketScopeAuthorization.js",
      "types": "./src/ticketScopeAuthorization.ts"
    },
    "./clientScopeSqlAdapters": {
      "import": "./dist/clientScopeSqlAdapters.js",
      "types": "./src/clientScopeSqlAdapters.ts"
    },
    "./recordProjection": {
      "import": "./dist/recordProjection.js",
      "types": "./src/recordProjection.ts"
    },
    "./rbac": {
      "import": "./dist/rbac.js",
      "types": "./src/rbac.ts"
    },
    "./recordCreateAuthorization": {
      "import": "./dist/recordCreateAuthorization.js",
      "types": "./src/recordCreateAuthorization.ts"
    }
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@alga-psa/db": "*",
    "@alga-psa/types": "*",
    "knex": "^3.1.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.7.3"
  }
}
