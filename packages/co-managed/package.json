{
  "name": "@alga-psa/co-managed",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./conversationRichText": {
      "types": "./src/conversationRichText.ts",
      "import": "./src/conversationRichText.ts"
    },
    "./conversationContent": {
      "types": "./src/conversationContent.ts",
      "import": "./src/conversationContent.ts"
    },
    "./inboundRequesterReply": {
      "types": "./src/inboundRequesterReply.ts",
      "import": "./dist/inboundRequesterReply.js"
    },
    "./inboundEmailReply": {
      "types": "./src/inboundEmailReply.ts",
      "import": "./dist/inboundEmailReply.js"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsup"
  },
  "dependencies": {
    "@alga-psa/db": "*",
    "@alga-psa/licensing": "*",
    "knex": "^3.1.0",
    "@alga-psa/authorization": "*",
    "@alga-psa/shared": "*"
  },
  "devDependencies": {
    "typescript": "^5.4.0",
    "tsup": "^8.0.0"
  }
}
