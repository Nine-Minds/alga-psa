{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://alga-psa.local/schemas/translation-glossary.schema.json",
  "title": "AlgaPSA translation glossary",
  "type": "object",
  "required": [
    "locale",
    "dialect",
    "displayName",
    "description",
    "domainTerms",
    "forbiddenTerms",
    "dialectRules",
    "identicalAllowlist"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "locale": { "type": "string", "minLength": 2 },
    "dialect": { "type": "string", "minLength": 2 },
    "displayName": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "domainTerms": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "en-term", "notes"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "en-term": { "type": "string", "minLength": 1 },
          "term": { "type": "string", "minLength": 1 },
          "pt-br-term": { "type": "string", "minLength": 1 },
          "notes": { "type": "string", "minLength": 1 }
        },
        "patternProperties": {
          "^[a-z]{2}(?:-[a-z]{2})?-term$": { "type": "string", "minLength": 1 }
        },
        "anyOf": [
          { "required": ["term"] },
          { "required": ["pt-br-term"] },
          {
            "not": {
              "properties": {
                "id": {},
                "en-term": {},
                "term": {},
                "pt-br-term": {},
                "notes": {}
              },
              "additionalProperties": false
            }
          }
        ],
        "additionalProperties": false
      }
    },
    "forbiddenTerms": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["term", "preferred", "reason"],
        "properties": {
          "term": { "type": "string", "minLength": 1 },
          "preferred": { "type": "string", "minLength": 1 },
          "reason": { "type": "string", "minLength": 1 },
          "enWhen": { "type": "string", "minLength": 1 },
          "unless": { "type": "string", "minLength": 1 },
          "keyUnless": { "type": "string", "minLength": 1 },
          "caseSensitive": { "type": "boolean" }
        },
        "additionalProperties": false
      }
    },
    "dialectRules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "rule", "notes"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "rule": { "type": "string", "minLength": 1 },
          "notes": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    },
    "identicalAllowlist": {
      "type": "object",
      "required": ["exact", "caseInsensitive", "patterns", "notes"],
      "properties": {
        "exact": { "type": "array", "items": { "type": "string" } },
        "caseInsensitive": { "type": "array", "items": { "type": "string" } },
        "patterns": { "type": "array", "items": { "type": "string" } },
        "notes": { "type": "string" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
